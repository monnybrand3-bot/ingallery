{
  "name": "ingallery-production-webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "dev:clean": "bash ./scripts/start-clean.sh",
    "build": "tsc --project tsconfig.json && vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "preview": "vite preview --host 0.0.0.0",
    "start:server": "node dist-server/server/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@supabase/supabase-js": "^2.57.0",
    "@types/multer": "^2.2.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
