{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "removeComments": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["app.ts", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
